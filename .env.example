# Copy this file to .env and fill in real values.
#
# .env is gitignored; this example is committed so the required variables
# are documented.

# Required. Signs session cookies and CSRF tokens.
# Generate with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-random-value


# How one-time codes are delivered.
#   console  log the code instead of sending it (default, development only)
#   null     discard it (tests)
#   msg91    send it through MSG91's Flow API
SMS_BACKEND=console

# Required when SMS_BACKEND=msg91.
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_TEMPLATE_ID=your-dlt-approved-template-id

# Optional.
# MSG91_OTP_VAR=OTP        # template variable holding the code
# MSG91_SENDER=SPNDLY      # sender / DLT header, if your flow needs one
